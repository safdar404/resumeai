# Copy to .streamlit/secrets.toml locally, or paste into
# Streamlit Community Cloud → App → Settings → Secrets. Never commit real keys.
# Keys are read exactly as written: stray spaces or smart quotes are reported, not silently fixed.
LLM_PROVIDER = "openai"          # none | openai | anthropic | openai_compatible
LLM_MODEL = "gpt-4o-mini"
OPENAI_API_KEY = "sk-your-key-here"
# ANTHROPIC_API_KEY = "sk-ant-your-key-here"
# OPENAI_COMPATIBLE_API_KEY = "your-key"
# OPENAI_COMPATIBLE_BASE_URL = "https://api.groq.com/openai/v1"

# Alternate provider presets (select ONE; never commit real API keys):
# RESUME_LLM_PROVIDER = "groq"
# GROQ_API_KEY = "your-real-key"
# RESUME_LLM_MODEL = "llama-3.3-70b-versatile"
# RESUME_LLM_PROVIDER = "gemini"
# GEMINI_API_KEY = "your-real-key"
# RESUME_LLM_MODEL = "gemini-2.5-flash"
# OpenAI and Anthropic use OPENAI_API_KEY / ANTHROPIC_API_KEY.
# LLM_PROVIDER/LLM_MODEL, when set, take precedence over RESUME_LLM_*.
