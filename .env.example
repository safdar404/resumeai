# Copy to .env (never commit it). Environment variables override Streamlit secrets.
# Leave LLM_PROVIDER=none to run fully offline with the deterministic engine.
LLM_PROVIDER=none
# One of: none | openai | anthropic | openai_compatible
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
